<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Keine gefährlichen Berechtigungen nötig.
         ACTION_DIAL öffnet nur den Dialer, ohne CALL_PHONE-Berechtigung.
         Die Kontaktauswahl nutzt ACTION_PICK auf einer einzelnen Telefonnummer;
         dafür erteilt Android eine temporäre Lese-Berechtigung nur für den
         zurückgegebenen Eintrag, ohne READ_CONTACTS-Berechtigung. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.PanicHelper">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PanicHelper">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MainActivity ist eine reine ComponentActivity (keine AppCompatActivity).
             Diese Deklaration aktiviert AppCompats automatische Speicherung/Anwendung
             der Sprachauswahl (AppCompatDelegate.setApplicationLocales) auch für
             Activities ohne AppCompatActivity, inkl. Persistenz über Neustarts (API < 33). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

    </application>

</manifest>